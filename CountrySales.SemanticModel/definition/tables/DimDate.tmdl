	partition DimDate = calculated
		mode: import
		source = ```
				
				VAR MinDate = MIN(SalesTransactions[Order Date])
				VAR MaxDate = MAX(SalesTransactions[Order Date])
				RETURN
				ADDCOLUMNS (
				    CALENDAR (MinDate, MaxDate),
				    "Year", YEAR([Date]),
				    "Month", FORMAT([Date], "MMMM"),
				    "MonthNum", MONTH([Date]),    
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "MonthShort", FORMAT([Date], "MMM"),
				    "MonthSort", YEAR([Date]) * 100 + MONTH([Date])
				)
				```

	annotation PBI_Id = cd6e21a603e94f7d86f4fb7f041db03e

